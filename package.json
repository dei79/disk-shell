{
  "name": "diskshell",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:x86_64": "DISKSHELL_TARGET_ARCH=x86_64 node build.mjs",
    "build:arm64": "DISKSHELL_TARGET_ARCH=arm64 node build.mjs",
    "build:all": "npm run build:x86_64 && npm run build:arm64",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs && node test/run-go.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sass": "1.103.1",
    "typescript": "7.0.2"
  }
}
